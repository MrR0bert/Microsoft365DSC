[ClassVersion("1.0.0.0")]
class MSFT_IntuneBrandingProfileAssignments
{
    [Write, Description("The type of the target assignment."), ValueMap{"#microsoft.graph.groupAssignmentTarget","#microsoft.graph.allLicensedUsersAssignmentTarget","#microsoft.graph.allDevicesAssignmentTarget","#microsoft.graph.exclusionGroupAssignmentTarget","#microsoft.graph.configurationManagerCollectionAssignmentTarget"}, Values{"#microsoft.graph.groupAssignmentTarget","#microsoft.graph.allLicensedUsersAssignmentTarget","#microsoft.graph.allDevicesAssignmentTarget","#microsoft.graph.exclusionGroupAssignmentTarget","#microsoft.graph.configurationManagerCollectionAssignmentTarget"}] String dataType;
    [Write, Description("The type of filter of the target assignment i.e. Exclude or Include. Possible values are:none, include, exclude."), ValueMap{"none","include","exclude"}, Values{"none","include","exclude"}] String deviceAndAppManagementAssignmentFilterType;
    [Write, Description("The Id of the filter for the target assignment.")] String deviceAndAppManagementAssignmentFilterId;
    [Write, Description("The display name of the filter for the target assignment.")] String deviceAndAppManagementAssignmentFilterDisplayName;
    [Write, Description("The group Id that is the target of the assignment.")] String groupId;
    [Write, Description("The group Display Name that is the target of the assignment.")] String groupDisplayName;
    [Write, Description("The collection Id that is the target of the assignment.(ConfigMgr)")] String collectionId;
};

[ClassVersion("1.0.0.0")]
class MSFT_MicrosoftGraphRgbColor
{
    [Write, Description("The amount of red")] UInt32 R;
    [Write, Description("The amount of green")] UInt32 G;
    [Write, Description("The amount of blue")] UInt32 B;
};

[ClassVersion("1.0.0.0"), FriendlyName("IntuneBrandingProfiles")]
class MSFT_IntuneBrandingProfiles : OMI_BaseResource
{
    [Key, Description("The name of the branding profile.")] String DisplayName;
    [Write, Description("The unique identifier for an entity. Read-only.")] String Id;

    [Write, Description("Represents the assignment to the Intune branding profile."), EmbeddedInstance("MSFT_IntuneBrandingProfileAssignments")] String Assignments[];

    [Write, Description("Email address of the IT support contact shown in the Company Portal.")] String ContactItEmailAddress;
    [Write, Description("Name of the IT support contact shown in the Company Portal.")] String ContactItName;
    [Write, Description("Additional notes for IT support displayed in the Company Portal.")] String ContactItNotes;
    [Write, Description("Phone number of the IT support contact shown in the Company Portal.")] String ContactItPhoneNumber;
    [Write, Description("Custom message shown to users who are allowed to view the privacy message.")] String CustomCanSeePrivacyMessage;
    [Write, Description("Custom message shown to users who are not allowed to view the privacy message.")] String CustomCantSeePrivacyMessage;
    [Write, Description("Main custom privacy message displayed in the Company Portal.")] String CustomPrivacyMessage;
    [Write, Description("Indicates whether telemetry and diagnostic messages are disabled in the Company Portal.")] Boolean DisableClientTelemetry;
    [Write, Description("Indicates whether the device category selection is disabled during enrollment.")] Boolean DisableDeviceCategorySelection;
    [Write, Description("Defines the availability of the enrollment profile. Values: 'availableWithPrompts', 'availableWithoutPrompts', 'unavailable'."),
        ValueMap{"availableWithPrompts", "availableWithoutPrompts", "unavailable"},
        Values{"availableWithPrompts", "availableWithoutPrompts", "unavailable"}] String EnrollmentAvailability;
    [Write, Description("Indicates whether this is the default branding profile.")] Boolean IsDefaultProfile;
    [Write, Description("Indicates whether the factory reset option is disabled for corporate-owned devices.")] Boolean IsFactoryResetDisabled;
    [Write, Description("Indicates whether the remove device option is disabled for corporate-owned devices.")] Boolean IsRemoveDeviceDisabled;
    [Write, Description("Image displayed on the customized landing page in the Company Portal.")] String LandingPageCustomizedImage;
    [Write, Description("Logo used when the Company Portal is in light theme.")] String LightBackgroundLogo;
    [Write, Description("Name of the online support site shown in the Company Portal.")] String OnlineSupportSiteName;
    [Write, Description("URL of the online support site shown in the Company Portal.")] String OnlineSupportSiteUrl;
    [Write, Description("URL of the organization's privacy policy.")] String PrivacyUrl;
    [Write, Description("Description of the branding profile.")] String ProfileDescription;
    [Write, Description("Name of the branding profile.")] String ProfileName;
    [Write, Description("List of role scope tag IDs assigned to this profile.")] String RoleScopeTagIds[];
    [Write, Description("Indicates whether a push notification is sent when device ownership changes.")] Boolean SendDeviceOwnershipChangePushNotification;
    [Write, Description("Indicates whether Azure AD Enterprise applications are shown in the Company Portal.")] Boolean ShowAzureAdEnterpriseApps;
    [Write, Description("Indicates whether Configuration Manager applications are shown in the Company Portal.")] Boolean ShowConfigurationManagerApps;
    [Write, Description("Indicates whether the display name should appear next to the logo.")] Boolean ShowDisplayNameNextToLogo;
    [Write, Description("Indicates whether the logo should be shown in the Company Portal.")] Boolean ShowLogo;
    [Write, Description("Indicates whether Office web applications are shown in the Company Portal.")] Boolean ShowOfficeWebApps;
    [Write, Description("Primary theme color used in the Company Portal."), EmbeddedInstance("MSFT_MicrosoftGraphRgbColor")] String ThemeColor;
    [Write, Description("Logo shown using the specified theme color.")] String ThemeColorLogo;

    [Write, Description("Supported values for the notification type to use."),
        ValueMap{"Present", "Absent"},
        Values{"Present", "Absent"}]
        String Ensure;

    [Write, Description("Credentials of the Intune Admin"), EmbeddedInstance("MSFT_Credential")] String Credential;
    [Write, Description("Id of the Azure Active Directory application to authenticate with.")] String ApplicationId;
    [Write, Description("Name of the Azure Active Directory tenant used for authentication. Format contoso.onmicrosoft.com")] String TenantId;
    [Write, Description("Secret of the Azure Active Directory tenant used for authentication."), EmbeddedInstance("MSFT_Credential")] String ApplicationSecret;
    [Write, Description("Thumbprint of the Azure Active Directory application's authentication certificate to use for authentication.")] String CertificateThumbprint;
	[Write, Description("Managed ID being used for authentication.")] Boolean ManagedIdentity;
    [Write, Description("Access token used for authentication.")] String AccessTokens[];
};
